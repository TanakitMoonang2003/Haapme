# MongoDB
# Replace with your actual connection string (e.g. from MongoDB Atlas)
MONGODB_URI=mongodb://localhost:27017/hbdtome

# App secret for session tokens (generate with: openssl rand -hex 32)
NUXT_SESSION_PASSWORD=change-me-to-a-random-secret

# Only 'mock' is currently implemented
PAYMENT_PROVIDER=mock

# Optional PromptPay ID used to generate payment QR codes
# PROMPTPAY_ID=0812345678

# AES-256-GCM key สำหรับเข้ารหัสเบอร์พร้อมเพย์ของเจ้าของหน้า
# ต้องตั้งค่านี้หากเจ้าของหน้าจะบันทึก PromptPay ID
# สร้างด้วย: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# PROMPTPAY_ENCRYPTION_KEY=

# Profanity word list path (relative to project root, optional override)
# PROFANITY_LIST_PATH=server/config/profanity.txt
